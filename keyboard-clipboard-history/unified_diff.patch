diff -ruN a/usr/share/maliit/plugins/com/jolla/KeyboardBase.qml b/usr/share/maliit/plugins/com/jolla/KeyboardBase.qml
--- a/usr/share/maliit/plugins/com/jolla/KeyboardBase.qml	2026-10-31 10:26:40.160891563 +0200
+++ b/usr/share/maliit/plugins/com/jolla/KeyboardBase.qml	2026-10-31 10:27:08.746112986 +0200
@@ -96,6 +96,40 @@
     // Can be changed to PreeditTestHandler to have another mode of input
     property Item inputHandler: InputHandler {}
 
+    // Patch clipboard-history: the last 10 copied texts, newest first. Kept only in memory:
+    // gone when the keyboard restarts, and emptied with "Clear clipboard". The keyboard
+    // sees copies made while it is hidden too (tested on the phone).
+    property var clipboardHistory: []
+    property bool clipboardHistoryOpen
+
+    function clearClipboardHistory() {
+        clipboardHistory = []
+        clipboardHistoryOpen = false
+    }
+
+    Connections {
+        target: Clipboard
+        onTextChanged: {
+            var text = Clipboard.text
+            if (text === "")
+                return
+            var history = [text]
+            for (var i = 0; i < keyboard.clipboardHistory.length && history.length < 10; ++i) {
+                if (keyboard.clipboardHistory[i] !== text)
+                    history.push(keyboard.clipboardHistory[i])
+            }
+            keyboard.clipboardHistory = history
+        }
+    }
+
+    Connections {
+        target: MInputMethodQuick
+        onActiveChanged: {
+            if (!MInputMethodQuick.active)
+                keyboard.clipboardHistoryOpen = false
+        }
+    }
+
     readonly property bool swipeGestureIsSafe: !releaseTimer.running
     readonly property string sourceDirectory: "/usr/share/maliit/plugins/com/jolla/layouts/"
 
