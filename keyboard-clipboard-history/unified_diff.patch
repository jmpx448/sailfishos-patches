diff -ruN a/usr/lib64/qt5/qml/com/jolla/keyboard/HorizontalPredictionListView.qml b/usr/lib64/qt5/qml/com/jolla/keyboard/HorizontalPredictionListView.qml
--- a/usr/lib64/qt5/qml/com/jolla/keyboard/HorizontalPredictionListView.qml	2026-10-31 10:26:40.163422647 +0200
+++ b/usr/lib64/qt5/qml/com/jolla/keyboard/HorizontalPredictionListView.qml	2026-10-31 10:27:08.746485941 +0200
@@ -3,6 +3,7 @@
 
 import QtQuick 2.6
 import Sailfish.Silica 1.0
+import com.meego.maliitquick 1.0
 
 PredictionListView {
     id: view
@@ -18,10 +19,64 @@
         view.positionViewAtBeginning()
     }
 
-    header: PasteButton {
-        onClicked: {
-            view.handler.paste(Clipboard.text)
-            keyboard.expandedPaste = false
+    // Patch clipboard-history: [history button][history items when open][paste button].
+    // A history item is committed directly (after any unfinished word), so the clipboard
+    // itself is not changed.
+    header: Row {
+        height: view.height
+
+        IconButton {
+            width: Theme.itemSizeSmall
+            height: parent.height
+            visible: keyboard.pasteEnabled && keyboard.clipboardHistory.length > 1
+            icon.source: keyboard.clipboardHistoryOpen ? "image://theme/icon-m-input-remove"
+                                                       : "image://theme/icon-m-history"
+            onClicked: {
+                keyboard.clipboardHistoryOpen = !keyboard.clipboardHistoryOpen
+                keyboard.expandedPaste = false
+                view.positionViewAtBeginning()
+            }
+        }
+
+        Repeater {
+            model: keyboard.clipboardHistoryOpen ? keyboard.clipboardHistory : []
+
+            BackgroundItem {
+                width: historyLabel.width + 2 * Theme.paddingLarge
+                height: view.height
+
+                onClicked: {
+                    var handler = view.handler
+                    if (handler.preedit !== undefined && handler.preedit !== ""
+                            && typeof handler.commit === "function") {
+                        handler.commit(handler.preedit)
+                    }
+                    MInputMethodQuick.sendCommit(modelData)
+                    keyboard.clipboardHistoryOpen = false
+                    keyboard.expandedPaste = false
+                }
+
+                Label {
+                    id: historyLabel
+
+                    x: Theme.paddingLarge
+                    width: Math.min(implicitWidth, view.width / 2)
+                    height: parent.height
+                    text: modelData.replace(/\n/g, " ")
+                    font.pixelSize: Theme.fontSizeSmall
+                    verticalAlignment: Text.AlignVCenter
+                    truncationMode: TruncationMode.Fade
+                    maximumLineCount: 1
+                }
+            }
+        }
+
+        PasteButton {
+            visible: keyboard.pasteEnabled && !keyboard.clipboardHistoryOpen
+            onClicked: {
+                view.handler.paste(Clipboard.text)
+                keyboard.expandedPaste = false
+            }
         }
     }
 
