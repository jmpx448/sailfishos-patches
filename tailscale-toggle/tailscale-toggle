#!/bin/sh
# Tailscale on/off for the Settings page. Runs as the user: tailscaled was set up with
# --operator=defaultuser, so up/down need no root. The state goes to dconf, where the page
# reads it (/apps/tailscale-toggle/state and /ip). `watch` keeps it current for the top menu
# switch, also when tailscale changes on its own (network change): once a minute, and dconf
# is written only when something changed.
# `up` repeats the flags of the original setup: without them tailscale refuses to change
# settings that differ from the defaults.
TS=/usr/local/bin/tailscale
set_key() { # key value: write only on change (dconf writes wake every reader)
    [ "$(dconf read "$1")" = "'$2'" ] || dconf write "$1" "'$2'"
}
publish() {
    state=$($TS status --json 2>/dev/null | sed -n 's/^\s*"BackendState": "\([A-Za-z]*\)".*/\1/p' | head -1)
    [ -n "$state" ] || state=Unknown
    ip=$($TS ip -4 2>/dev/null | head -1)
    set_key /apps/tailscale-toggle/state "$state"
    set_key /apps/tailscale-toggle/ip "$ip"
}
case "$1" in
    on)  $TS up --accept-dns=false --hostname=jolla --operator=defaultuser --timeout=30s ;;
    off) $TS down ;;
    status) ;;
    watch) while :; do publish; sleep 60; done ;;
    *) echo "usage: $0 on|off|status|watch" >&2; exit 2 ;;
esac
rc=$?
publish
exit $rc
